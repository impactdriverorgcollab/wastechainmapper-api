generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  FIELD_VERIFIER
  PUBLIC_VIEWER
}

enum SiteStatus {
  UNVERIFIED
  ACTIVE
  INACTIVE
  REMEDIATED
}

enum WasteType {
  MUNICIPAL
  ORGANIC
  PLASTIC
  INDUSTRIAL
  MEDICAL
  ELECTRONIC
  CONSTRUCTION
  MIXED
  UNKNOWN
}

enum ConfidenceTier {
  LOW
  MEDIUM
  HIGH
}

enum ReportSourceType {
  NEWS_SCRAPE
  TWITTER_SCRAPE
  WHATSAPP_CITIZEN
  MANUAL_ENTRY
}

enum GeocodeStatus {
  PENDING
  RESOLVED_GAZETTEER
  RESOLVED_NOMINATIM
  UNRESOLVED
}

enum VerificationStatus {
  UNVERIFIED
  CORROBORATED
  FIELD_VERIFIED
  REJECTED
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum FlowStatus {
  PENDING
  COLLECTED
  IN_TRANSIT
  DELIVERED
  PROCESSED
}

enum FacilityType {
  COLLECTION_POINT
  TRANSFER_STATION
  RECYCLING
  LANDFILL
  INCINERATION
}

enum WaterSourceType {
  EXTRACTION
  DISTRIBUTION
  CONSUMPTION
  WASTEWATER
}

enum WaterAnomalyType {
  LEAK
  ILLEGAL_EXTRACTION
  CONTAMINATION
}

enum FloodRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum ApiKeyTier {
  FREE
  PROFESSIONAL
  ENTERPRISE
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String?  @map("display_name")
  role         UserRole @default(PUBLIC_VIEWER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  verifications Verification[]

  @@map("users")
}

model DumpSite {
  id String @id @default(uuid()) @db.Uuid

  // PostGIS geography column — Prisma marks it Unsupported; use $queryRaw/$executeRaw for any
  // operation that touches this column. The denormalized latitude/longitude below are kept in
  // sync by the application on every write and are readable by the Prisma ORM normally.
  location  Unsupported("geography(Point, 4326)")?
  latitude  Float?
  longitude Float?

  status         SiteStatus     @default(UNVERIFIED)
  wasteType      WasteType      @default(UNKNOWN)  @map("waste_type")
  confidenceTier ConfidenceTier @default(LOW)      @map("confidence_tier")

  sourceReportIds String[] @default([]) @map("source_report_ids") @db.Uuid

  communityName String?  @map("community_name")
  ward          String?
  lga           String?
  description   String?
  imageUrls     String[] @default([]) @map("image_urls")

  firstSeenAt     DateTime  @default(now()) @map("first_seen_at")
  lastConfirmedAt DateTime? @map("last_confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  reports       Report[]
  verifications Verification[]
  outgoingFlows WasteFlow[]    @relation("SourceSite")

  @@index([lga])
  @@index([ward])
  @@index([confidenceTier])
  @@map("dump_sites")
}

model CollectionPoint {
  id String @id @default(uuid()) @db.Uuid

  location  Unsupported("geography(Point, 4326)")?
  latitude  Float?
  longitude Float?

  name            String
  operator        String?
  ward            String?
  lga             String?
  isActive        Boolean @default(true) @map("is_active")
  coverageRadiusM Float?  @map("coverage_radius_m")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lga])
  @@map("collection_points")
}

model Report {
  id String @id @default(uuid()) @db.Uuid

  rawText    String          @map("raw_text")
  sourceUrl  String?         @map("source_url")
  sourceType ReportSourceType @map("source_type")

  extractedLocationText String?   @map("extracted_location_text")
  extractedWasteType    WasteType? @map("extracted_waste_type")
  extractedSeverity     String?   @map("extracted_severity")
  extractedUrgency      String?   @map("extracted_urgency")

  geocodeStatus     GeocodeStatus @default(PENDING) @map("geocode_status")
  geocodedLatitude  Float?        @map("geocoded_latitude")
  geocodedLongitude Float?        @map("geocoded_longitude")
  geocodeSource     String?       @map("geocode_source")

  // 0.0–1.0 composite: source credibility × geocode certainty × corroboration count
  confidenceScore Float? @map("confidence_score")

  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  linkedSiteId       String?            @map("linked_site_id") @db.Uuid

  publishedAt DateTime? @map("published_at")
  scrapedAt   DateTime  @default(now()) @map("scraped_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  linkedSite    DumpSite?      @relation(fields: [linkedSiteId], references: [id])
  verifications Verification[]

  @@index([geocodeStatus])
  @@index([verificationStatus])
  @@index([sourceType])
  @@index([linkedSiteId])
  @@map("reports")
}

model Verification {
  id         String             @id @default(uuid()) @db.Uuid
  reportId   String?            @map("report_id") @db.Uuid
  siteId     String?            @map("site_id") @db.Uuid
  verifierId String             @map("verifier_id") @db.Uuid
  fromStatus VerificationStatus @map("from_status")
  toStatus   VerificationStatus @map("to_status")
  notes      String?
  createdAt  DateTime           @default(now()) @map("created_at")

  report   Report?   @relation(fields: [reportId], references: [id])
  site     DumpSite? @relation(fields: [siteId], references: [id])
  verifier User      @relation(fields: [verifierId], references: [id])

  @@map("verifications")
}

model Gazetteer {
  id            String @id @default(uuid()) @db.Uuid
  communityName String @map("community_name")
  ward          String
  lga           String

  centroid    Unsupported("geography(Point, 4326)")?
  centroidLat Float?  @map("centroid_lat")
  centroidLng Float?  @map("centroid_lng")

  // Ward/community boundary polygon for containment queries
  boundary Unsupported("geography(Polygon, 4326)")?

  aliases String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([communityName, ward, lga])
  @@index([lga])
  @@index([ward])
  @@map("gazetteer")
}

// ─── WasteChainMapper extensions ───────────────────────────────────────────────

model Facility {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  facilityType FacilityType @map("facility_type")

  location  Unsupported("geography(Point, 4326)")?
  latitude  Float?
  longitude Float?

  operator    String?
  capacityTpd Float?  @map("capacity_tpd")
  ward        String?
  lga         String?
  isActive    Boolean @default(true) @map("is_active")
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  incomingFlows WasteFlow[] @relation("DestinationFacility")

  @@index([facilityType])
  @@index([lga])
  @@map("facilities")
}

model WasteFlow {
  id            String     @id @default(uuid()) @db.Uuid
  wasteType     WasteType  @default(UNKNOWN) @map("waste_type")
  status        FlowStatus @default(PENDING)

  estimatedTonnage Float? @map("estimated_tonnage")

  sourceSiteId         String? @map("source_site_id") @db.Uuid
  originLat            Float?  @map("origin_lat")
  originLng            Float?  @map("origin_lng")
  destinationFacilityId String? @map("destination_facility_id") @db.Uuid
  vehicleId            String? @map("vehicle_id") @db.Uuid

  ward String?
  lga  String?

  collectedAt  DateTime? @map("collected_at")
  inTransitAt  DateTime? @map("in_transit_at")
  deliveredAt  DateTime? @map("delivered_at")
  processedAt  DateTime? @map("processed_at")
  notes        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sourceSite           DumpSite?            @relation("SourceSite", fields: [sourceSiteId], references: [id])
  destinationFacility  Facility?            @relation("DestinationFacility", fields: [destinationFacilityId], references: [id])
  vehicle              CollectionVehicle?   @relation(fields: [vehicleId], references: [id])
  routePoints          VehicleRoutePoint[]

  @@index([status])
  @@index([lga])
  @@index([wasteType])
  @@map("waste_flows")
}

model CollectionVehicle {
  id          String  @id @default(uuid()) @db.Uuid
  plateNumber String  @unique @map("plate_number")
  operator    String?
  capacityM3  Float?  @map("capacity_m3")
  isActive    Boolean @default(true) @map("is_active")

  lastSeenLat Float?    @map("last_seen_lat")
  lastSeenLng Float?    @map("last_seen_lng")
  lastSeenAt  DateTime? @map("last_seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  flows       WasteFlow[]
  routePoints VehicleRoutePoint[]

  @@map("collection_vehicles")
}

model VehicleRoutePoint {
  id        String @id @default(uuid()) @db.Uuid
  vehicleId String @map("vehicle_id") @db.Uuid
  flowId    String? @map("flow_id") @db.Uuid

  location  Unsupported("geography(Point, 4326)")?
  latitude  Float
  longitude Float
  speedKmh  Float? @map("speed_kmh")

  recordedAt DateTime @default(now()) @map("recorded_at")

  vehicle CollectionVehicle @relation(fields: [vehicleId], references: [id])
  flow    WasteFlow?         @relation(fields: [flowId], references: [id])

  @@index([vehicleId])
  @@index([flowId])
  @@index([recordedAt])
  @@map("vehicle_route_points")
}

model WaterSource {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  sourceType WaterSourceType @map("source_type")

  location  Unsupported("geography(Point, 4326)")?
  latitude  Float?
  longitude Float?

  operator    String?
  ward        String?
  lga         String?
  isActive    Boolean @default(true) @map("is_active")
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  readings  WaterReading[]
  anomalies WaterAnomaly[]

  @@index([sourceType])
  @@index([lga])
  @@map("water_sources")
}

model WaterReading {
  id       String @id @default(uuid()) @db.Uuid
  sourceId String @map("source_id") @db.Uuid

  volumeM3     Float? @map("volume_m3")
  qualityScore Float? @map("quality_score")
  ph           Float?
  turbidityNtu Float? @map("turbidity_ntu")
  isSensor     Boolean @default(false) @map("is_sensor")
  notes        String?

  recordedAt DateTime @default(now()) @map("recorded_at")
  createdAt  DateTime @default(now()) @map("created_at")

  source WaterSource @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([recordedAt])
  @@map("water_readings")
}

model WaterAnomaly {
  id         String           @id @default(uuid()) @db.Uuid
  sourceId   String?          @map("source_id") @db.Uuid
  anomalyType WaterAnomalyType @map("anomaly_type")

  location  Unsupported("geography(Point, 4326)")?
  latitude  Float?
  longitude Float?

  severity    String?
  description String?
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  source WaterSource? @relation(fields: [sourceId], references: [id])

  @@index([anomalyType])
  @@map("water_anomalies")
}

model FloodZone {
  id        String         @id @default(uuid()) @db.Uuid
  name      String?
  riskLevel FloodRiskLevel @default(MEDIUM) @map("risk_level")

  // Polygon boundary for spatial containment queries
  boundary Unsupported("geography(Polygon, 4326)")?

  ward        String?
  lga         String?
  description String?
  source      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([riskLevel])
  @@index([lga])
  @@map("flood_zones")
}

model ApiKey {
  id         String     @id @default(uuid()) @db.Uuid
  keyHash    String     @unique @map("key_hash")
  name       String
  tier       ApiKeyTier @default(FREE)
  callsToday Int        @default(0) @map("calls_today")
  callsTotal Int        @default(0) @map("calls_total")
  dailyLimit Int        @default(100) @map("daily_limit")
  isActive   Boolean    @default(true) @map("is_active")
  ownerId    String?    @map("owner_id") @db.Uuid
  lastUsedAt DateTime?  @map("last_used_at")
  resetAt    DateTime   @default(now()) @map("reset_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([tier])
  @@map("api_keys")
}

// Simple polling queue — no Redis/Celery for MVP.
// Scraper claims PENDING rows, marks RUNNING, then DONE or FAILED.
model ScrapeJob {
  id          String    @id @default(uuid()) @db.Uuid
  jobType     String    @map("job_type")
  status      JobStatus @default(PENDING)
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  errorMsg    String?   @map("error_msg")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("scrape_jobs")
}
