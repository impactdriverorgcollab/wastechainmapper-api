# Copy to .env and fill in values. Never put real credentials in this file.

# Local Docker database (see docker-compose.yml)
DATABASE_URL="postgresql://wastewatch:localdev@localhost:5432/wastewatch_dev?schema=public"

# Hosted database (for example Supabase). Use the pooled connection string and set DATABASE_SSL=true.
# DATABASE_URL="postgresql://postgres:<password>@<host>:5432/postgres"
# DATABASE_SSL=true

# Long random string, for example: openssl rand -hex 48
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Origin of the web app. Comma separate to allow more than one.
CORS_ORIGIN="http://localhost:3000"

PORT=3001

# Used only by scripts/seed-admin.ts
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
